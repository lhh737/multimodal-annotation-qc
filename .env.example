# 火山方舟 Ark（OpenAI 兼容）
# 复制本文件为 .env，填入真实 key；.env 已在 .gitignore 中
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=your_ark_api_key_here

# 模型 ID（如调用报 model not found，改成控制台里的推理接入点 ID）
ARK_MODEL_A=deepseek-v4-flash
ARK_MODEL_B=glm-5.3

# 可选：每次请求的超时与重试
ARK_TIMEOUT=120
ARK_MAX_RETRIES=3

# ---------- 其他 OpenAI 兼容 provider（可选） ----------
# DeepSeek 官方
# GEN_BASE_URL=https://api.deepseek.com
# GEN_API_KEY=
# GEN_MODEL_ID=deepseek-flash

# 腾讯 TokenHub（含 deepseek / glm / kimi）
# TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
# TOKENHUB_API_KEY=

# 阿里百炼 DashScope
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=
